{
  "name": "rastro",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm --filter @rastro/web run dev",
    "worker": "pnpm --filter @rastro/worker run dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -p tsconfig.json",
    "wallets:new": "pnpm --filter @rastro/chain run wallets:new",
    "wallets:fund": "pnpm --filter @rastro/chain run wallets:fund",
    "chain:check": "pnpm --filter @rastro/chain run check",
    "contracts:build": "pnpm --filter @rastro/contracts run build && pnpm --filter @rastro/chain run abi:export",
    "contracts:test": "pnpm --filter @rastro/contracts run test",
    "abi:export": "pnpm --filter @rastro/chain run abi:export",
    "chain:setup": "pnpm --filter @rastro/chain run onchain-setup",
    "chain:fill-test": "pnpm --filter @rastro/chain run fill-test",
    "pix:smoke": "pnpm --filter @rastro/pix run smoke",
    "db:migrate": "pnpm --filter @rastro/db run migrate",
    "db:seed": "pnpm --filter @rastro/core run seed",
    "fx:ptax": "pnpm --filter @rastro/core run ptax",
    "pix:webhook": "pnpm --filter @rastro/core run pix-webhook",
    "saque:test": "pnpm --filter @rastro/core run saque-test",
    "lastro": "pnpm --filter @rastro/core run reserves",
    "lastro:test": "pnpm --filter @rastro/core run lastro-test",
    "relatorio:conferir": "pnpm --filter @rastro/core run reconcile"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
