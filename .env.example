# Tempo testnet (Moderato, chain 42431)
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Testnet keys only. `pnpm wallets:new` prints a fresh set.
ADMIN_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
QUOTER_PRIVATE_KEY=
PAYER_PRIVATE_KEY=
ANA_PRIVATE_KEY=

# tBRL that `pnpm chain:setup` mints into the RFQ. Mirrors the PayZu sandbox's starting balance.
# Addresses are not here: setup writes them to packages/chain/deployments/moderato.json.
RFQ_INVENTORY_BRL=10000

# Pix: sandbox or simulator
PIX_MODE=sandbox
PAYZU_BASE_URL=https://pix.sandbox.payzu.dev
PAYZU_TOKEN=
PAYZU_WEBHOOK_SECRET=

# App
DATABASE_URL=
SPREAD_BPS=50
ADMIN_TOKEN=
