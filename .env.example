# Tempo testnet (Moderato, chain 42431)
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Testnet keys only. `pnpm wallets:new` prints a fresh set.
ADMIN_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
QUOTER_PRIVATE_KEY=
PAYER_PRIVATE_KEY=
ANA_PRIVATE_KEY=

# Most tBRL that `pnpm chain:setup` mints into the RFQ. With PIX_MODE=sandbox it never
# mints past the sandbox balance. Addresses are not here: setup writes them to
# packages/chain/deployments/moderato.json.
RFQ_INVENTORY_BRL=10000

# Pix: sandbox (PayZu) or simulator (ours, no credential needed)
PIX_MODE=sandbox
PAYZU_BASE_URL=https://pix.sandbox.payzu.dev
PAYZU_TOKEN=
# Printed once by `pnpm pix:webhook https://<app>/api/webhooks/pix`
PAYZU_WEBHOOK_SECRET=

# Postgres (Supabase or Neon). The pooled connection string works for the app and the worker.
DATABASE_URL=

# Quotes: spread over the PTAX, in basis points
SPREAD_BPS=50
# Pins the PTAX, e.g. for a recording: 5.4123@2026-10-09
PTAX_OVERRIDE=

# Admin routes: /admin and POST /api/admin/*. Without it the admin answers 503.
ADMIN_TOKEN=
# Salt for the CPF hash. Without one, a random salt is kept in the database, which is
# enough for test documents but not for real ones (decision 0004).
CPF_SALT=
