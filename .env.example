# Rastro's environment. Nothing here has a value on purpose: `pnpm wallets:new` prints the
# keys, the PayZu sandbox prints the credential, and your database gives you its URL.
#
# Where each one goes when deployed (DEPLOY.md has the walkthrough):
#   app on Vercel     everything except nothing; the API routes sign and read the chain
#   worker on Railway everything except nothing; it runs the watcher, the withdrawals and
#                     the reserve monitor, and signs as the treasury and the admin
#   your machine      the same file, for the scripts (demo:reset, ensaio, lastro, pix:*)
# The two deploys share the same values. Keys are testnet keys; none of this is real money.

# Tempo testnet (Moderato, chain 42431)
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Testnet keys only. `pnpm wallets:new` prints a fresh set.
ADMIN_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
QUOTER_PRIVATE_KEY=
PAYER_PRIVATE_KEY=
ANA_PRIVATE_KEY=

# Most tBRL that `pnpm chain:setup` and `pnpm demo:reset` keep in the RFQ. Neither ever
# mints past the reais behind it. Addresses are not here: setup writes them to
# packages/chain/deployments/moderato.json, which is committed.
RFQ_INVENTORY_BRL=10000

# Pix: sandbox (PayZu) or simulator (ours, no credential needed). The credential lasts 24 h;
# when it stops answering the worker falls back to the simulator and every screen says so.
# `pnpm pix:credencial` checks it and registers the webhook again.
PIX_MODE=sandbox
PAYZU_BASE_URL=https://pix.sandbox.payzu.dev
PAYZU_TOKEN=
# Printed once by `pnpm pix:credencial https://<app>/api/webhooks/pix`
PAYZU_WEBHOOK_SECRET=

# Postgres (Supabase or Neon). The pooled connection string works for the app and the worker.
DATABASE_URL=

# Quotes: spread over the PTAX, in basis points
SPREAD_BPS=50
# Pins the PTAX, e.g. for a recording: 5.4123@2026-10-09
PTAX_OVERRIDE=

# /admin and POST /api/admin/*. Without it the admin answers 503.
ADMIN_TOKEN=
# Salt for the CPF hash. Without one, a random salt is kept in the database, which is
# enough for test documents but not for real ones (decision 0004).
CPF_SALT=

# Only for a local EVM (anvil), never on Moderato: BATCH_CALLS=false sends the approve and
# the fill as two transactions, and WATCH_FROM_BLOCK pins where the watcher starts reading.
# BATCH_CALLS=
# WATCH_FROM_BLOCK=
